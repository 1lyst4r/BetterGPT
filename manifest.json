{
  "manifest_version": 3,
  "name": "BetterGPT",
  "description": "Custom themes, settings, prompt tools, and quality-of-life controls for ChatGPT.",
  "version": "0.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "BetterGPT",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "permissions": [
    "storage",
    "notifications",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": [
        "src/styles/bettergpt.css"
      ],
      "js": [
        "src/content/config.js",
        "src/content/icons.js",
        "src/content/storage.js",
        "src/content/dom.js",
        "src/content/themes.js",
        "src/content/tools.js",
        "src/content/features.js",
        "src/content/panel.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
